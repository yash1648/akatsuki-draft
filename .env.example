# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (MongoDB)
MONGODB_URI=mongodb://localhost:27017/akatsuki_draft

# Authentication / Security
JWT_SECRET=super_secret_jwt_key_at_least_32_characters_long_for_akatsuki_draft
JWT_EXPIRES_IN=24h

# AI Service Configuration
# If GEMINI_API_KEY is not provided, the server can use fallback content enhancement in dev/test mode.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
AI_TIMEOUT_MS=30000
AI_RATE_LIMIT_MAX=10
